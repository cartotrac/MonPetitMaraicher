# Variables d'environnement — copier en `.env` (dev) ou renseigner
# dans la configuration WSGI AlwaysData (prod). Ne jamais committer le .env.

DJANGO_SECRET_KEY=change-moi-avec-une-longue-chaine-aleatoire
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,monpetitmaraicher.example.com

# Base de données : laissée vide => SQLite (dev / instance mono-ferme)
# En prod AlwaysData, PostgreSQL :
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=moncompte_mpm
# DB_USER=moncompte_mpm
# DB_PASSWORD=***
# DB_HOST=postgresql-moncompte.alwaysdata.net
# DB_PORT=5432
